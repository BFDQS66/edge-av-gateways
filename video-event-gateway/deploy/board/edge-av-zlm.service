[Unit]
Description=Edge AV ZLMediaKit RTSP and RTMP server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/orangepi/edge-av/run/config.ini

[Service]
Type=simple
WorkingDirectory=/home/orangepi/edge-av/third_party/ZLMediaKit/release/linux/Release
RuntimeDirectory=edge-av-zlm
RuntimeDirectoryMode=0700
ExecStart=/home/orangepi/edge-av/third_party/ZLMediaKit/release/linux/Release/MediaServer --config /home/orangepi/edge-av/run/config.ini --log-dir %t/edge-av-zlm/log --level 3 --max_day 1 --log-slice 2 --log-size 2 --threads 2
Restart=on-failure
RestartSec=3
StandardOutput=null
StandardError=null
UMask=0077

[Install]
WantedBy=default.target
