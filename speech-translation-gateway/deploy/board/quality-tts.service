[Unit]
Description=Orange Pi Kokoro high-quality TTS service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/workspace/speech-translation-gateway
ExecStart=%h/workspace/speech-translation-gateway/build/quality_tts_server %h/workspace/speech-translation-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
