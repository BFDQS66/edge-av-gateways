[Unit]
Description=Orange Pi C++ speech translation gateway
After=speech-gateway.service llama-translate.service
Wants=speech-gateway.service llama-translate.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/workspace/speech-translation-gateway
ExecStart=%h/workspace/speech-translation-gateway/build/translation_server
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
MemoryMax=512M
TasksMax=32
LimitNOFILE=512
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
