[Unit]
Description=Orange Pi on-screen live translation dashboard
After=live-translate.service
Wants=live-translate.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/chromium --ozone-platform=wayland --user-data-dir=/dev/shm/speech-live-chromium --no-first-run --no-default-browser-check --disable-application-cache --disk-cache-size=1 --disable-session-crashed-bubble --app=http://127.0.0.1:8770 --start-maximized
Restart=on-failure
RestartSec=10
MemoryMax=1G
TasksMax=256
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
